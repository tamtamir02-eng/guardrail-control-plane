apiVersion: serving.knative.dev/v1
kind: Service
metadata:
  name: guardrail-worker
  annotations:
    run.googleapis.com/ingress: internal
spec:
  template:
    metadata:
      annotations:
        autoscaling.knative.dev/minScale: "0"
        autoscaling.knative.dev/maxScale: "2"
    spec:
      serviceAccountName: GUARDRAIL_WORKER_RUNTIME_SA
      containerConcurrency: 1
      timeoutSeconds: 300
      containers:
        - image: REGION-docker.pkg.dev/PROJECT_ID/guardrail/control-plane@sha256:IMAGE_DIGEST
          ports:
            - name: http1
              containerPort: 8080
          env:
            - name: GUARDRAIL_RUNTIME_ROLE
              value: worker
            - name: GUARDRAIL_PREFLIGHT_MODE
              value: production
            - name: GUARDRAIL_TARGET_REPOSITORY
              value: tamtamir02-eng/codex-guardrail-pilot
            - name: GUARDRAIL_EXPECTED_COMMIT
              value: FULL_COMMIT_SHA
            - name: GUARDRAIL_DEPLOYED_COMMIT
              value: FULL_COMMIT_SHA
            - name: GUARDRAIL_BUILD_COMMIT_PATH
              value: /app/BUILD_COMMIT
            - name: GUARDRAIL_IMAGE_DIGEST
              value: sha256:IMAGE_DIGEST
            - name: GUARDRAIL_VERSION
              value: 4.2.0
            - name: GITHUB_APP_ID
              value: GITHUB_APP_NUMERIC_ID
            - name: GITHUB_PRIVATE_KEY_PATH
              value: /var/run/secrets/guardrail/github-app.pem
            - name: GUARDRAIL_REQUIRE_TASK_HEADER
              value: "true"
          resources:
            limits:
              cpu: "1"
              memory: 1Gi
          startupProbe:
            httpGet:
              path: /health
            periodSeconds: 5
            timeoutSeconds: 1
            failureThreshold: 12
          livenessProbe:
            httpGet:
              path: /health
            periodSeconds: 30
            timeoutSeconds: 2
            failureThreshold: 3
          volumeMounts:
            - name: github-app-key
              mountPath: /var/run/secrets/guardrail
      volumes:
        - name: github-app-key
          secret:
            secretName: guardrail-v42-github-app-private-key
            items:
              - key: SECRET_VERSION
                path: github-app.pem
